#!/bin/sh
# CookingGoMod - remove: restore pristine game scripts.
case "$1" in
    remove|purge|upgrade|disappear) ;;
    *) exit 0 ;;
esac

BAK_DIR=/var/mobile/Library/Caches/cookingmod
APP_EXEC=AirplaneCooking-mobile.app

for BUNDLE in /private/var/containers/Bundle/Application/*/"$APP_EXEC" \
              /var/containers/Bundle/Application/*/"$APP_EXEC"; do
    [ -d "$BUNDLE" ] || continue
    SCRIPT="$BUNDLE/assets/scriptBundle/index.js"
    BAK="$BAK_DIR/index.js.orig"
    if [ -f "$SCRIPT" ] && [ -f "$BAK" ]; then
        cat "$BAK" > "$SCRIPT" 2>/dev/null && echo "CookingGoMod: restored $SCRIPT"
    fi

    JSC="$BUNDLE/assets/scriptBundle/index.jsc"
    JSC_BAK="$BAK_DIR/index.jsc.orig"
    if [ -f "$JSC" ] && [ -f "$JSC_BAK" ]; then
        cat "$JSC_BAK" > "$JSC" 2>/dev/null && echo "CookingGoMod: restored $JSC"
    fi
done

rm -rf "$BAK_DIR" 2>/dev/null
exit 0
